{
  "manifest_version": 3,
  "name": "OGS Plus",
  "short_name": "OGS+",
  "version": "1.0.0",
  "description": "OGS(Online-Go.com)를 더 편리하게! 다국어 설정, 실시간 음성 해설 자동 채팅 입력, 이미지 링크 미리보기, 커스텀 CSS, About 헤딩 단축키, 프로필 승률 통계, SGF 업로드, 통합 알림.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://online-go.com/*",
    "https://*.online-go.com/*",
    "https://beta.online-go.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "OGS Plus"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://online-go.com/*",
        "https://*.online-go.com/*",
        "https://beta.online-go.com/*"
      ],
      "js": [
        "lib/browser-polyfill.js",
        "lib/storage.js",
        "i18n/translations.js",
        "content/utils.js",
        "content/notice.js",
        "content/settings-tab.js",
        "content/voice-commentary.js",
        "content/image-preview.js",
        "content/custom-css.js",
        "content/about-heading.js",
        "content/beta-link.js",
        "content/profile-stats.js",
        "content/sgf-upload.js",
        "content/bot-rank-request.js",
        "content/notifications-watcher.js",
        "content/main.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*.css"
      ],
      "matches": [
        "https://online-go.com/*",
        "https://*.online-go.com/*",
        "https://beta.online-go.com/*"
      ]
    }
  ]
}
